{
  "name": "b-cal",
  "version": "1.3.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@b-cal/web",
    "dev:api": "turbo run dev --filter=@b-cal/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "prisma:generate": "turbo run prisma:generate --filter=@b-cal/api",
    "prisma:migrate": "turbo run prisma:migrate --filter=@b-cal/api",
    "prisma:seed": "turbo run prisma:seed --filter=@b-cal/api",
    "prisma:studio": "turbo run prisma:studio --filter=@b-cal/api",
    "db:up": "docker compose up postgres -d",
    "db:down": "docker compose down postgres",
    "redis:up": "docker compose up redis -d",
    "redis:down": "docker compose down redis",
    "services:up": "docker compose up postgres redis -d",
    "services:down": "docker compose down postgres redis",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt",
      "@prisma/engines",
      "@sentry-internal/node-cpu-profiler",
      "esbuild",
      "prisma",
      "unrs-resolver"
    ],
    "overrides": {
      "lodash@>=4.0.0 <=4.17.22": ">=4.17.23",
      "qs@>=6.7.0 <=6.14.1": ">=6.14.2",
      "ajv@>=8 <8.18.0": ">=8.18.0",
      "hono@<4.11.10": ">=4.11.10",
      "minimatch@>=4 <10.2.3": ">=10.2.3",
      "rollup@>=4.0.0 <4.59.0": ">=4.59.0",
      "serialize-javascript@<=7.0.2": ">=7.0.3",
      "multer@<2.1.0": ">=2.1.0",
      "minimatch@<3.1.3": ">=3.1.3",
      "minimatch@<3.1.4": ">=3.1.4",
      "multer@<2.1.1": ">=2.1.1",
      "hono@<4.12.4": ">=4.12.4",
      "@hono/node-server@<1.19.10": ">=1.19.10",
      "file-type@>=13.0.0 <21.3.1": ">=21.3.1",
      "hono@<4.12.7": ">=4.12.7",
      "file-type@>=20.0.0 <=21.3.1": ">=21.3.2"
    }
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx}": [
      "pnpm -C apps/web exec eslint --fix",
      "prettier --write"
    ],
    "apps/api/**/*.ts": [
      "pnpm -C apps/api exec eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "turbo": "^2.8.3"
  }
}
