{
  "name": "b-cal",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@b-cal/web",
    "dev:api": "turbo run dev --filter=@b-cal/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "prisma:generate": "turbo run prisma:generate --filter=@b-cal/api",
    "prisma:migrate": "turbo run prisma:migrate --filter=@b-cal/api",
    "prisma:seed": "turbo run prisma:seed --filter=@b-cal/api",
    "prisma:studio": "turbo run prisma:studio --filter=@b-cal/api",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt",
      "@prisma/engines",
      "@sentry-internal/node-cpu-profiler",
      "esbuild",
      "prisma",
      "unrs-resolver"
    ],
    "overrides": {
      "lodash@>=4.0.0 <=4.17.22": ">=4.17.23",
      "hono@<4.11.7": ">=4.11.7",
      "qs@>=6.7.0 <=6.14.1": ">=6.14.2",
      "ajv@>=8 <8.18.0": ">=8.18.0",
      "ajv@<8.18.0": ">=8.18.0",
      "minimatch@<10.2.1": ">=10.2.1"
    }
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx}": [
      "pnpm -C apps/web exec eslint --fix",
      "prettier --write"
    ],
    "apps/api/**/*.ts": [
      "pnpm -C apps/api exec eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "turbo": "^2.8.3"
  }
}
