// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())

  email         String  @unique
  password      String
  emailVerified Boolean @default(false)

  verificationToken String?
  resetToken        String?

  calendarEntry CalendarEntry[]
  preferences   UserPreferences?
  sessions      Session[]

  updatedAt DateTime? @updatedAt
  createdAt DateTime  @default(now())
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String
  deviceName   String?
  ipAddress    String?
  userAgent    String?
  lastUsedAt   DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model CalendarEntry {
  id String @id @default(uuid())

  title     String
  startDate DateTime
  endDate   DateTime

  content  String?
  wholeDay Boolean? @default(false)

  recurrenceFrequency String?
  recurrenceByDay     String?
  recurrenceUntil     DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  recurrenceExceptions RecurrenceException[]

  updatedAt DateTime? @updatedAt
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([startDate])
  @@index([endDate])
  @@index([endDate, startDate])
  @@index([recurrenceFrequency])
}

model RecurrenceException {
  id              String        @id @default(uuid())
  calendarEntry   CalendarEntry @relation(fields: [calendarEntryId], references: [id], onDelete: Cascade)
  calendarEntryId String
  originalDate    DateTime
  isCancelled     Boolean       @default(false)

  title     String?
  startDate DateTime?
  endDate   DateTime?
  content   String?
  wholeDay  Boolean?

  updatedAt DateTime? @updatedAt
  createdAt DateTime  @default(now())

  @@unique([calendarEntryId, originalDate])
  @@index([calendarEntryId])
}

model UserPreferences {
  userId String @id

  language String
  timezone String

  theme       String @default("system")
  accentColor String @default("blue")
  weekStart   String @default("monday")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  updatedAt DateTime? @updatedAt
  createdAt DateTime  @default(now())
}
