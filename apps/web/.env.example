NEXT_PUBLIC_BACKEND_URL=http://localhost:3000

# Public base URL of the web app. Used to build absolute social-share
# preview image URLs (Open Graph / Twitter). Set this in production to your
# real domain, e.g. https://b-cal.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:8080

# Sentry source map upload at build time (optional).
SENTRY_ORG=
SENTRY_PROJECT=
